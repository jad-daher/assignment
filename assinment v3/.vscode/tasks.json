{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake -S \"${workspaceFolder}\" -B \"${workspaceFolder}/build\"",
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "dependsOn": "CMake: configure",
            "command": "cmake --build \"${workspaceFolder}/build\"",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
